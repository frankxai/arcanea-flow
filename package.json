{
  "name": "arcanea-flow",
  "version": "1.0.0-alpha.1",
  "description": "Arcanea Flow V1 - Multi-agent swarm orchestration with Guardian intelligence",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "arcanea-flow": "./v3/@arcanea-flow/cli/bin/cli.js"
  },
  "workspaces": [
    "v3/@arcanea-flow/shared",
    "v3/@arcanea-flow/swarm",
    "v3/@arcanea-flow/mcp",
    "v3/@arcanea-flow/aidefence",
    "v3/@arcanea-flow/embeddings",
    "v3/@arcanea-flow/cli"
  ],
  "files": [
    "v3/@arcanea-flow/cli/bin/**",
    "v3/@arcanea-flow/cli/dist/**",
    "v3/@arcanea-flow/cli/package.json",
    "v3/@arcanea-flow/shared/dist/**",
    "v3/@arcanea-flow/shared/package.json",
    "v3/@arcanea-flow/swarm/dist/**",
    "v3/@arcanea-flow/swarm/package.json",
    "v3/@arcanea-flow/mcp/dist/**",
    "v3/@arcanea-flow/mcp/package.json",
    "v3/@arcanea-flow/aidefence/dist/**",
    "v3/@arcanea-flow/aidefence/package.json",
    "v3/@arcanea-flow/embeddings/dist/**",
    "v3/@arcanea-flow/embeddings/package.json",
    ".claude-plugin/**",
    ".claude/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run build --workspaces --if-present",
    "build:ts": "cd v3/@arcanea-flow/cli && npm run build || true",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:security": "vitest run v3/__tests__/security/",
    "lint": "cd v3/@arcanea-flow/cli && npm run lint || true",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "security:test": "npm run test:security",
    "v3:domains": "npm run build:domains",
    "v3:swarm": "npm run start:swarm",
    "v3:security": "npm run security:audit && npm run security:test"
  },
  "dependencies": {
    "agentdb": "2.0.0-alpha.3.4",
    "bcrypt": "^5.1.1",
    "zod": "^3.22.4"
  },
  "overrides": {
    "hono": ">=4.11.4"
  },
  "devDependencies": {
    "@ruvector/attention": "^0.1.3",
    "@ruvector/sona": "^0.1.5",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "agentic-flow": "^2.0.1-alpha.80",
    "eslint": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea-flow.git"
  },
  "keywords": [
    "arcanea",
    "ai",
    "agents",
    "swarm",
    "guardians",
    "ddd",
    "domain-driven-design"
  ],
  "author": "Frank (Arcanea)",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  }
}
